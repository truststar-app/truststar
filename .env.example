# ── Required ──────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Optional: persistent recent-audits feed ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ── Optional: waitlist ────────────────────────────────────────────────────────
WAITLIST_SECRET=your_secret_here

# ── Optional: scoring thresholds (safe to omit — defaults are used) ───────────
# Tune these to adjust detection sensitivity.
# Values shown are the defaults.
SCORE_VELOCITY_MULTIPLIER=
SCORE_VELOCITY_WEIGHT=
SCORE_CONC_THRESHOLD_10K=
SCORE_CONC_THRESHOLD_1K=
SCORE_CONC_THRESHOLD_100=
SCORE_CONC_WEIGHT=
SCORE_ZSCORE_NORM=
SCORE_ZSCORE_WEIGHT=
SCORE_NEW_ACCOUNT_DAYS=
SCORE_LOCKSTEP_SIMILARITY=
SCORE_LOCKSTEP_WINDOW_DAYS=
SCORE_LOCKSTEP_MIN_SHARED=
SCORE_LOCKSTEP_MIN_CLUSTER=
SCORE_BURST_MULTIPLIER=
SCORE_AUTH_LOW_ACTIVITY_WEIGHT=
SCORE_AUTH_LOCKSTEP_WEIGHT=
SCORE_AUTH_BURST_WEIGHT=
